{
  "_doc": "Who sees what (plan section 12.2). rule -> role -> scope. Scopes: all, loc (their locations), team (people who report to them, and themselves), own (their own records). '+perm' needs that permission; '+a|b' needs either. A role not listed gets nothing. Owners and admins hold every permission. Viewers only ever read (the gateway refuses their writes). The same file is packages/py-common/friday_common/access_rules.json; a kernel test fails if they differ.",
  "pos.sell":              {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "loc+cashier", "member": "loc+cashier"},
  "sales.read":            {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team", "member": "own", "viewer": "all"},
  "sales.refund":          {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team"},
  "invoices.read":         {"owner": "all", "admin": "all", "branch_manager": "loc", "viewer": "all"},
  "invoices.write":        {"owner": "all", "admin": "all", "branch_manager": "loc"},
  "customers.read":        {"owner": "all", "admin": "all", "branch_manager": "all", "team_leader": "all", "member": "all+cashier|sales", "viewer": "all"},
  "customers.write":       {"owner": "all", "admin": "all", "branch_manager": "all", "team_leader": "all+cashier|sales", "member": "all+cashier|sales"},
  "crm.read":              {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team", "member": "own+sales", "viewer": "all"},
  "crm.write":             {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team", "member": "own+sales"},
  "stock.read":            {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "loc", "member": "loc+cashier|warehouse", "viewer": "all"},
  "stock.write":           {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "loc+warehouse", "member": "loc+warehouse"},
  "purchasing.read":       {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "loc+purchasing", "member": "loc+purchasing", "viewer": "all"},
  "purchasing.write":      {"owner": "all", "admin": "all", "branch_manager": "loc+purchasing", "team_leader": "loc+purchasing", "member": "loc+purchasing"},
  "books.read":            {"owner": "all", "admin": "all", "branch_manager": "loc", "viewer": "all+accounting"},
  "books.write":           {"owner": "all", "admin": "all"},
  "staff.read":            {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team"},
  "pay.read":              {"owner": "all", "admin": "all+hr", "branch_manager": "own", "team_leader": "own", "member": "own"},
  "pay.write":             {"owner": "all", "admin": "all+hr"},
  "claims.submit":         {"owner": "own", "admin": "own", "branch_manager": "own", "team_leader": "own", "member": "own"},
  "claims.read":           {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team", "member": "own"},
  "claims.approve":        {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team"},
  "deliveries.read":       {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team", "member": "own+logistics", "viewer": "all"},
  "deliveries.write":      {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team", "member": "own+logistics"},
  "settings.write":        {"owner": "all", "admin": "all"},
  "tills.write":           {"owner": "all", "admin": "all", "branch_manager": "loc"},
  "payment_methods.write": {"owner": "all", "admin": "all", "branch_manager": "loc"},
  "integrations.write":    {"owner": "all", "admin": "all"},
  "people.read":           {"owner": "all", "admin": "all", "branch_manager": "loc", "team_leader": "team"},
  "people.write":          {"owner": "all", "admin": "all", "branch_manager": "loc"},
  "host.manage":           {"owner": "all"}
