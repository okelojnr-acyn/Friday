# Copy to .env and adjust for your machine. scripts/setup.sh does this for
# you. Every service reads these same variable names (see ARCHITECTURE.md's
# "trust boundary" section) -- there's one config convention, not one per
# language.

# --- shared secrets (same value everywhere; change for anything but local dev) ---
JWT_SECRET=dev-only-change-me
KERNEL_EVENTS_TOKEN=dev-only-change-me

# --- postgres ---
POSTGRES_USER=friday
POSTGRES_PASSWORD=friday
POSTGRES_DB=friday
# Go-style DSN (kernel)
DATABASE_URL=postgres://friday:friday@localhost:5432/friday
# SQLAlchemy-style DSN (apps/*) -- same server, async driver
APPS_DATABASE_URL=postgresql+asyncpg://friday:friday@localhost:5432/friday

# --- kernel ---
PORT=8080
CORS_ORIGIN=http://localhost:5173
APP_CRM_URL=http://localhost:8001
APP_INVOICING_URL=http://localhost:8002
APP_PROJECTS_URL=http://localhost:8003
APP_INVENTORY_URL=http://localhost:8004
APP_WEB3_URL=http://localhost:8005
APP_MINIONS_URL=http://localhost:8007

# --- passwordless auth (WebAuthn passkeys + emailed OTP fallback) ---
# RP_ID must be the bare domain the browser's address bar shows --
# "localhost" for local dev, "app.example.com" in production. It has to
# match what CORS_ORIGIN above actually serves web/ from, or passkey
# ceremonies fail to verify.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Friday

# SMTP_HOST unset (the default) logs OTP codes to the kernel's own stdout
# instead of emailing them -- every local/dev run and CI job works with
# zero mail-server setup. Set these for real delivery; works against any
# SMTP relay (a real provider's SMTP endpoint, Mailtrap/Mailpit for
# staging, a self-hosted Postfix) -- see kernel/internal/mail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Friday <no-reply@example.com>

# --- web ---
# Where web/src/lib/api.ts sends every request; the kernel gateway fronts
# everything else.
VITE_KERNEL_URL=http://localhost:8080
