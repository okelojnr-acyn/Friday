# Friday on one server (deploy/compose.yml). Friday Host generates this
# file for installs it manages; by hand, fill in every value below.
# Never commit the real .env.

# Release to run: a commit SHA from github.com/okelojnr-acyn/Friday whose
# CI published images (or "latest").
FRIDAY_VERSION=latest

# The domain Friday is served on. Point its A record at this server first:
# Caddy gets the certificate from Let's Encrypt on the first start.
FRIDAY_DOMAIN=friday.example.com
FRIDAY_NAME=Friday

# Secrets: long random strings, e.g. `openssl rand -hex 32` each.
POSTGRES_PASSWORD=
JWT_SECRET=
KERNEL_EVENTS_TOKEN=

# Optional: run Friday on your own PostgreSQL 14+ instead of the bundled
# one. The role needs CREATE on the database (Friday makes the schemas
# core, crm, invoicing, projects, inventory, web3, accounting, minions,
# fleets). Use sslmode=require or verify-full for any other host. Check it:
#   docker compose run --rm --no-deps kernel dbcheck
# FRIDAY_DATABASE_URL=postgres://friday:password@db.example.com:5432/friday?sslmode=require

# Email for sign-in codes. Without SMTP_HOST the codes are only written to
# the kernel's log (docker compose logs kernel).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
